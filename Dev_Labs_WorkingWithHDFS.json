{"paragraphs":[{"text":"%md\n# About This Lab\n**Objective:** In this exercise, you will practice working with HDFS—the Hadoop Distributed File System—using the HDFS command line interface.\n**File locations:** $DEVDATA/exercises/hdfs\n**Successful outcome:**\n**Before you begin:**\n**Related lessons:** Explore HDFS Using the Command Line Interface\n\nCopyright © 2010–2021 Cloudera. All rights reserved.\nNot to be reproduced or shared without prior written consent from Cloudera.\n\n---","user":"anonymous","dateUpdated":"2026-11-16T11:00:37-0800","config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","editorHide":true,"fontSize":9,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984854_1534980926","id":"20171105-200834_1116095891","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:00:37-0800","dateFinished":"2026-11-16T11:00:37-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"focus":true,"$$hashKey":"object:2225"},{"text":"%md\n# Setup\n---","user":"anonymous","dateUpdated":"2026-11-16T11:00:37-0800","config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984855_433328581","id":"20181114-164229_902436001","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:00:37-0800","dateFinished":"2026-11-16T11:00:37-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2226"},{"text":"%sh\nhdfs dfs -rm -r -f /devsh_loudacre\n# create the directory 'downloads' en /var/lib/zeppelin/downloads\nrm -rf downloads\nmkdir -p downloads","user":"anonymous","dateUpdated":"2026-11-16T11:29:06-0800","config":{"tableHide":false,"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/sh","fontSize":9,"editorHide":false,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984856_1196398736","id":"20181114-164621_138379904","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:00:38-0800","dateFinished":"2026-11-16T11:00:41-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2227"},{"text":"%md\n# Lab\n---","user":"anonymous","dateUpdated":"2026-11-16T11:00:41-0800","config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984856_1190980906","id":"20181114-164844_1661453681","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:00:41-0800","dateFinished":"2026-11-16T11:00:41-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2228"},{"text":"%md\n## Explore HDFS Using the Command Line Interface","user":"anonymous","dateUpdated":"2026-11-16T11:00:41-0800","config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","editorHide":true,"fontSize":9,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984857_72665787","id":"20171105-200519_752831754","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:00:41-0800","dateFinished":"2026-11-16T11:00:41-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2229"},{"text":"%md\nUse the HDFS command line to list the content of the HDFS root directory using the following command:\n\n```shell\n$ hdfs dfs -ls /\n```","user":"anonymous","dateUpdated":"2026-11-16T11:00:41-0800","config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984857_-951301078","id":"20181115-084123_1911813743","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:00:41-0800","dateFinished":"2026-11-16T11:00:41-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2230"},{"title":"1 - List the content of the HDFS root directory","text":"%sh\nhdfs dfs -ls /\n","user":"anonymous","dateUpdated":"2026-11-16T11:00:41-0800","config":{"editorSetting":{"language":"sh","editOnDblClick":false,"completionSupport":false,"completionKey":"TAB"},"colWidth":12,"editorMode":"ace/mode/sh","fontSize":9,"title":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984858_547188190","id":"20171105-200623_656362182","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:00:41-0800","dateFinished":"2026-11-16T11:00:44-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2231"},{"text":"%md\nView the content of the /user directory.\n\nYou will see your home directory—training—in the listing.\n\n> #### Relative Paths\nIn HDFS, relative (non-absolute) paths are considered relative to your home directory. \nThere is no concept of a “current” or “working” directory as there is in Linux and similar filesystems.\n","user":"anonymous","dateUpdated":"2026-11-16T11:00:44-0800","config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984858_628181745","id":"20200110-174331_926232947","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:00:45-0800","dateFinished":"2026-11-16T11:00:45-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2232"},{"title":"2 - View the content of the /user directory","text":"%sh\nhdfs dfs -ls /user","user":"anonymous","dateUpdated":"2026-11-16T11:00:45-0800","config":{"tableHide":false,"editorSetting":{"language":"sh","editOnDblClick":false,"completionSupport":false,"completionKey":"TAB"},"colWidth":12,"editorMode":"ace/mode/sh","editorHide":false,"fontSize":9,"title":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984859_-1454145928","id":"20171105-201709_849284875","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:00:45-0800","dateFinished":"2026-11-16T11:00:48-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2233"},{"text":"%md\nList the contents of your home directory by running:\n\n```shell\n$ hdfs dfs -ls /user/training\n```\nNote that the directory structure in HDFS is unrelated to the directory structure of the local filesystem on the remote host; they are completely separate namespaces.","user":"anonymous","dateUpdated":"2026-11-16T11:00:48-0800","config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984859_-468361061","id":"20200110-174849_2107439154","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:00:48-0800","dateFinished":"2026-11-16T11:00:48-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2234"},{"title":"3 - List the content of your home directory","text":"%sh\nhdfs dfs -ls /user/zeppelin","user":"anonymous","dateUpdated":"2026-11-16T11:00:48-0800","config":{"tableHide":false,"editorSetting":{"language":"sh","editOnDblClick":false,"completionSupport":false,"completionKey":"TAB"},"colWidth":12,"editorMode":"ace/mode/sh","editorHide":false,"fontSize":9,"title":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984860_-1969404422","id":"20171105-201449_1118165660","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:00:48-0800","dateFinished":"2026-11-16T11:00:51-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2235"},{"text":"%md\nCreate a new directory called devsh_loudacre in the HDFS root directory. \nThe new directory will be the top-level directory for the remaining exercises in the course.\n\n```shell\n$ hdfs dfs -mkdir /devsh_loudacre\n```\n","user":"anonymous","dateUpdated":"2026-11-16T11:00:51-0800","config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984860_-1253065037","id":"20200110-175854_546852824","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:00:51-0800","dateFinished":"2026-11-16T11:00:51-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2236"},{"title":"4 - Create the /devsh_loudacre directory","text":"%sh\nhdfs dfs -mkdir /devsh_loudacre","user":"anonymous","dateUpdated":"2026-11-16T11:00:51-0800","config":{"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/sh","fontSize":9,"title":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984861_-126908533","id":"20200110-180146_1423651422","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:00:51-0800","dateFinished":"2026-11-16T11:00:54-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2237"},{"text":"%md\nInsert the activations directory into HDFS:\n\n```shell\n$ hdfs dfs -put /home/training/training_materials/dev/data/activations /devsh_loudacre/\n```\n\nThis copies the local activations directory and its contents into a remote HDFS directory named /devsh_loudacre/activations.","user":"anonymous","dateUpdated":"2026-11-16T11:00:54-0800","config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984861_-2069195648","id":"20200110-183600_765395929","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:00:54-0800","dateFinished":"2026-11-16T11:00:54-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2238"},{"title":"5 - Insert the activations directory into HDFS","text":"%sh\nhdfs dfs -put /home/training/training_materials/dev/data/activations /devsh_loudacre/","user":"anonymous","dateUpdated":"2026-11-16T11:00:54-0800","config":{"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/sh","fontSize":9,"title":true,"results":{},"enabled":true,"tableHide":false},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984862_-331715717","id":"20200110-185804_1045684730","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:00:54-0800","dateFinished":"2026-11-16T11:01:14-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2239"},{"title":"6 - Confirm the upload by listing the contents of the new directory","text":"%sh\nhdfs dfs -ls /devsh_loudacre/activations","user":"anonymous","dateUpdated":"2026-11-16T11:01:14-0800","config":{"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/sh","fontSize":9,"title":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984862_-601816555","id":"20200110-190841_1419158310","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:01:15-0800","dateFinished":"2026-11-16T11:01:17-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2240"},{"text":"%md\nView some of the data you just copied into HDFS.\n\n```shell\n$ hdfs dfs -cat /devsh_loudacre/activations/2014-03.xml | head -n 20\n```\n\nThis prints the first 20 lines of the article to your terminal. This command is handy for viewing text data in HDFS. An individual file is often very large, making it inconvenient to view the entire file in the terminal. For this reason, it is often a good idea to pipe the output of the dfs -cat command into head, more, or less. You can also use hdfs dfs -tail to more efficiently view the end of the file, rather than piping the whole content.\nNote: You may see a warning: cat: Unable to write to output stream. This is because the cat was only able to pipe the first 20 lines because of the limit specified in the head command. You can disregard the warning.","user":"anonymous","dateUpdated":"2026-11-16T11:01:17-0800","config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984862_263667006","id":"20200110-191104_1398798226","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:01:17-0800","dateFinished":"2026-11-16T11:01:17-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2241"},{"title":"7 - View some of the data you just copied into HDFS","text":"%sh\nhdfs dfs -cat /devsh_loudacre/activations/2014-03.xml | head -n 20","user":"anonymous","dateUpdated":"2026-11-16T11:01:17-0800","config":{"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/sh","fontSize":9,"title":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984863_-677090470","id":"20200110-191123_1425790902","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:01:17-0800","dateFinished":"2026-11-16T11:01:20-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2242"},{"text":"%md\nPractice downloading from HDFS by downloading the directory you uploaded above.\n\n```shell\n$ hdfs dfs -get /devsh_loudacre/activations/ /tmp/devsh_activations\n```","user":"anonymous","dateUpdated":"2026-11-16T11:01:20-0800","config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984863_230454272","id":"20200110-192002_492992324","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:01:20-0800","dateFinished":"2026-11-16T11:01:20-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2243"},{"title":"8 - Practice downloading from HDFS by downloading the directory you uploaded above","text":"%sh\nhdfs dfs -get /devsh_loudacre/activations/ /tmp/devsh_activations","user":"anonymous","dateUpdated":"2026-11-16T11:01:20-0800","config":{"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/sh","fontSize":9,"title":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984864_1858843825","id":"20200110-192101_1613152640","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:01:21-0800","dateFinished":"2026-11-16T11:01:24-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2244"},{"title":"9 - List the content of the directory in which you downloaded","text":"%sh\nls /tmp/devsh_activations","user":"anonymous","dateUpdated":"2026-11-16T11:01:24-0800","config":{"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/sh","fontSize":9,"title":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984864_-1704055873","id":"20200110-192729_1314765512","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:01:24-0800","dateFinished":"2026-11-16T11:01:24-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2245"},{"text":"%md\nRemove the directory you uploaded earlier.\n\n```shell\n$ hdfs dfs -rm -r /devsh_loudacre/activations/\n```\n","user":"anonymous","dateUpdated":"2026-11-16T11:01:24-0800","config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984865_-691654437","id":"20200110-193018_185134918","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:01:24-0800","dateFinished":"2026-11-16T11:01:24-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2246"},{"title":"10 - Remove the directory you uploaded earlier","text":"%sh\nhdfs dfs -rm -r /devsh_loudacre/activations/","user":"anonymous","dateUpdated":"2026-11-16T11:01:24-0800","config":{"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/sh","fontSize":9,"title":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984865_-924970783","id":"20200110-193032_719261657","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:01:24-0800","dateFinished":"2026-11-16T11:01:27-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2247"},{"text":"%md\nThere are several other operations available with the hdfs dfs command to perform most common filesystem manipulations such as mv, cp, and mkdir.\nUsing the hdfs dfs command with no arguments will display the available commands.\n\n```shell\n$ hdfs dfs\n```","user":"anonymous","dateUpdated":"2026-11-16T11:33:39-0800","config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"title":false,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984866_-1781373057","id":"20200110-193458_1944990180","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:33:39-0800","dateFinished":"2026-11-16T11:33:39-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2248"},{"text":"%md\n# Result\n**You have now:** practiced working with HDFS using the command line interface.\n\n---","user":"anonymous","dateUpdated":"2026-11-16T11:01:28-0800","config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984867_2004097501","id":"20181119-142716_792318228","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:01:28-0800","dateFinished":"2026-11-16T11:01:28-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2249"},{"title":"Additional resources","text":"%md\nWe hope you've enjoyed this lab. Below are additional resources that you should find useful:\n\n1. [Cloudera Tutorials](http://cloudera.com/tutorials.html) are your natural next step where you can explore Spark in more depth.\n2. [Cloudera Community](https://community.cloudera.com) is a great resource for questions and answers on Spark, Data Analytics/Science, and many more Big Data topics.\n3. [Apache Spark Documentation](https://spark.apache.org/documentation.html) - official Spark documentation.\n4. [Apache Zeppelin Project Home Page](https://zeppelin.apache.org) - official Zeppelin web site.","user":"anonymous","dateUpdated":"2026-11-16T11:01:28-0800","config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":10,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"title":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984874_662764670","id":"20181116-135131_93712280","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:01:28-0800","dateFinished":"2026-11-16T11:01:28-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2250"},{"text":"%angular\n</br>\n</br>\n</br>\n</br>\n<center>\n<a href=\"https://www.cloudera.com/about/training/courses.html\">\n  <img src=\"https://www.cloudera.com/content/dam/www/marketing/media-kit/logo-assets/cloudera_logo_darkorange.png\" alt=\"Cloudera Educational Services\" style=\"width:280px;height:40px;border:0;\" align=\"middle\">\n</a>\n</center>\n</br>\n</br>","user":"anonymous","dateUpdated":"2026-11-16T11:01:28-0800","config":{"tableHide":false,"editorSetting":{"language":"scala","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":2,"editorMode":"ace/mode/undefined","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984874_-356146276","id":"20200110-154537_1406191376","dateCreated":"2021-11-29T14:29:44-0800","dateStarted":"2026-11-16T11:01:28-0800","dateFinished":"2026-11-16T11:01:30-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2251"},{"text":"%angular\n","user":"anonymous","dateUpdated":"2026-11-16T11:01:30-0800","config":{"editorSetting":{"language":"scala","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/undefined","fontSize":9,"results":{},"enabled":true,"editorHide":true,"tableHide":false},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1638224984875_501743824","id":"20200110-162013_302547143","dateCreated":"2021-11-29T14:29:44-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2252"}],"name":"Dev/Labs/WorkingWithHDFS","id":"2GQJJ98YZ","noteParams":{},"noteForms":{},"angularObjects":{"md:shared_process":[],"angular:shared_process":[],"sh:shared_process":[],"livy:shared_process":[]},"config":{"isZeppelinNotebookCronEnable":false,"looknfeel":"default","personalizedMode":"false"},"info":{}}