{"paragraphs":[{"title":"HDFS Tutorial","text":"%md\n![HDFS Logo](https://hadoop.apache.org/docs/stable/hadoop-project-dist/hadoop-hdfs/images/hdfs-logo.jpg)\n---\n### In this notebook we will try the fundamentals operations of\n### ****HDFS (Hadoop Distributed File System)**\n---\nLet's try:\n\n.   How to navigate the HDFS directory structure.\n.   How to create/delete files and directories in HDFS.\n.   Checking HDFS properties, such as block size or the default replication factor.","user":"anonymous","dateUpdated":"2026-11-16T10:31:37-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/markdown","title":true,"editorHide":true,"tableHide":false},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792164953280_1957612543","id":"20261016-083553_1822103341","dateCreated":"2026-10-16T08:35:53-0700","dateStarted":"2026-11-16T10:31:37-0800","dateFinished":"2026-11-16T10:31:37-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"focus":true,"$$hashKey":"object:2259"},{"title":"List the contents of the root directory in HDFS (\"/\")","text":"%sh\nhdfs dfs -ls /","user":"anonymous","dateUpdated":"2026-11-16T10:31:37-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792165404053_1360503052","id":"20261016-084324_1727529447","dateCreated":"2026-10-16T08:43:24-0700","dateStarted":"2026-11-16T10:31:37-0800","dateFinished":"2026-11-16T10:31:42-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2260"},{"title":"List the contents of the user directory (\"/user\")","text":"%sh\nhdfs dfs -ls /user","user":"anonymous","dateUpdated":"2026-11-16T10:31:42-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792165432853_-1709104593","id":"20261016-084352_1459539280","dateCreated":"2026-10-16T08:43:52-0700","dateStarted":"2026-11-16T10:31:42-0800","dateFinished":"2026-11-16T10:31:45-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2261"},{"title":"Recursively list (\"-R\") the contents of the user directory (\"/user\")","text":"%sh\nhdfs dfs -ls -R /user","user":"anonymous","dateUpdated":"2026-11-16T10:31:45-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true,"editorHide":false},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792165874026_253873572","id":"20261016-085114_1225981261","dateCreated":"2026-10-16T08:51:14-0700","dateStarted":"2026-11-16T10:31:45-0800","dateFinished":"2026-11-16T10:31:49-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2262"},{"title":"Display the contents of the root directory of the user \"training\" (\"/user/training\")","text":"%sh\nhdfs dfs -ls /user/training","user":"anonymous","dateUpdated":"2026-11-16T10:31:49-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792165693640_-901319693","id":"20261016-084813_826887667","dateCreated":"2026-10-16T08:48:13-0700","dateStarted":"2026-11-16T10:31:49-0800","dateFinished":"2026-11-16T10:31:51-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2263"},{"title":"Display the contents of the current user's root directory (\"/user/zeppelin\")","text":"%sh\nhdfs dfs -ls /user/zeppelin","user":"anonymous","dateUpdated":"2026-11-16T10:31:52-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792166011307_-1432918007","id":"20261016-085331_465924359","dateCreated":"2026-10-16T08:53:31-0700","dateStarted":"2026-11-16T10:31:52-0800","dateFinished":"2026-11-16T10:31:54-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2264"},{"title":"Display the contents of the current user's root directory (\"/user/zeppelin\")","text":"%sh\nhdfs dfs -ls # If no path is specified, the root directory of the current user (zeppelin) is displayed by default.","user":"anonymous","dateUpdated":"2026-11-16T10:31:54-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792166158115_-1139057362","id":"20261016-085558_1052763898","dateCreated":"2026-10-16T08:55:58-0700","dateStarted":"2026-11-16T10:31:55-0800","dateFinished":"2026-11-16T10:31:57-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2265"},{"title":"Create the \"pruebas\" directory in the current user's root directory (\"/user/zeppelin\")","text":"%sh\nhdfs dfs -mkdir pruebas # if we specify a relative path (without a '/' at the beginning)\n                        # it will be relative to the root directory of the current user (zeppelin)","user":"anonymous","dateUpdated":"2026-11-16T10:31:57-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792166257365_-1179326829","id":"20261016-085737_429150501","dateCreated":"2026-10-16T08:57:37-0700","dateStarted":"2026-11-16T10:31:58-0800","dateFinished":"2026-11-16T10:32:00-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2266"},{"title":"Verify the creation of the \"pruebas\" directory","text":"%sh\nhdfs dfs -ls # We list the contents of the root directory of the user 'zeppelin' to verify it.","user":"anonymous","dateUpdated":"2026-11-16T10:32:00-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792166455415_-1449402820","id":"20261016-090055_543537344","dateCreated":"2026-10-16T09:00:55-0700","dateStarted":"2026-11-16T10:32:01-0800","dateFinished":"2026-11-16T10:32:03-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2267"},{"title":"Read the file \"ratings_2018.txt\" in the \"pruebas\" directory.","text":"%sh\nhdfs dfs -put /home/training/ratings_2018.txt pruebas","user":"anonymous","dateUpdated":"2026-11-16T10:32:03-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792166510538_1248637897","id":"20261016-090150_1434577947","dateCreated":"2026-10-16T09:01:50-0700","dateStarted":"2026-11-16T10:32:03-0800","dateFinished":"2026-11-16T10:32:07-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2268"},{"title":"Verify the creation of the file \"ratings_2018.txt\" in the \"pruebas\" directory.","text":"%sh\nhdfs dfs -ls pruebas","user":"anonymous","dateUpdated":"2026-11-16T10:32:07-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792166728003_-1168844560","id":"20261016-090528_1845397592","dateCreated":"2026-10-16T09:05:28-0700","dateStarted":"2026-11-16T10:32:07-0800","dateFinished":"2026-11-16T10:32:09-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2269"},{"title":"Verify the creation of the file \"ratings_2018.txt\" in the \"pruebas\" directory.","text":"%sh\nhdfs dfs -ls pruebas/ratings_2018.txt","user":"anonymous","dateUpdated":"2026-11-16T10:32:10-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true,"editorHide":false},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792169740823_547419818","id":"20261016-095540_231925967","dateCreated":"2026-10-16T09:55:40-0700","dateStarted":"2026-11-16T10:32:10-0800","dateFinished":"2026-11-16T10:32:12-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2270"},{"text":"%md\n### Now we will check some file and system properties, such as block size or replication factor.","user":"anonymous","dateUpdated":"2026-11-16T10:32:13-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/markdown","editorHide":true,"tableHide":false},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792167316113_1288751797","id":"20261016-091516_637783930","dateCreated":"2026-10-16T09:15:16-0700","dateStarted":"2026-11-16T10:32:13-0800","dateFinished":"2026-11-16T10:32:13-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2271"},{"title":"Check the default block size in HDFS (in bytes)","text":"%sh\nhdfs getconf -confkey dfs.blocksize","user":"anonymous","dateUpdated":"2026-11-16T10:32:13-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true,"editorHide":false,"tableHide":false},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792169813627_1308499107","id":"20261016-095653_988374028","dateCreated":"2026-10-16T09:56:53-0700","dateStarted":"2026-11-16T10:32:13-0800","dateFinished":"2026-11-16T10:32:14-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2272"},{"title":"Check the default block size in HDFS (in megabytes)","text":"%sh\necho \"$(( $(hdfs getconf -confKey dfs.blocksize) / 1024 / 1024 )) MB\"\n# hdfs getconf -confkey dfs.blocksize | awk '{ print $1 | (1024 * 1024) \" MB\"}' # It doesn't work for the moment","user":"anonymous","dateUpdated":"2026-11-16T10:32:15-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true,"editorHide":false,"tableHide":false},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792170021991_-1215714511","id":"20261016-100021_145987298","dateCreated":"2026-10-16T10:00:21-0700","dateStarted":"2026-11-16T10:32:15-0800","dateFinished":"2026-11-16T10:32:16-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2273"},{"title":"Check the block size assigned to the file \"ratings_2018.txt\"","text":"%sh\nhdfs dfs -du -h pruebas/ratings_2018.txt","user":"anonymous","dateUpdated":"2026-11-16T10:32:16-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true,"editorHide":false,"tableHide":false},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792170385455_-234784207","id":"20261016-100625_1982822216","dateCreated":"2026-10-16T10:06:25-0700","dateStarted":"2026-11-16T10:32:17-0800","dateFinished":"2026-11-16T10:32:20-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2274"},{"title":"Check the default replication factor in HDFS","text":"%sh\nhdfs getconf -confKey dfs.replication","user":"anonymous","dateUpdated":"2026-11-16T10:32:20-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792169965182_1479832895","id":"20261016-095925_1842108782","dateCreated":"2026-10-16T09:59:25-0700","dateStarted":"2026-11-16T10:32:20-0800","dateFinished":"2026-11-16T10:32:21-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2275"},{"title":"Check the default replication factor in HDFS for the file \"ratings_2018.txt\"","text":"%sh\nhdfs dfs -ls pruebas/ratings_2018.txt","user":"anonymous","dateUpdated":"2026-11-16T10:32:21-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792170543095_51112016","id":"20261016-100903_405332365","dateCreated":"2026-10-16T10:09:03-0700","dateStarted":"2026-11-16T10:32:21-0800","dateFinished":"2026-11-16T10:32:24-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2276"},{"title":"Create the file \"ratings_2019.txt\" in the \"pruebas\" directory, specifying the block size and the replication factor.","text":"%sh\n# Replication factor = 2\n# Block size = 64 mb\nhdfs dfs -D dfs.replication=2 -D dfs.blocksize=64M -put /home/training/ratings_2019.txt pruebas/ratings_2019.txt","user":"anonymous","dateUpdated":"2026-11-16T10:32:24-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792170683338_-1155852773","id":"20261016-101123_849397386","dateCreated":"2026-10-16T10:11:23-0700","dateStarted":"2026-11-16T10:32:24-0800","dateFinished":"2026-11-16T10:32:28-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2277"},{"title":"Check the block size and replication factor of the file \"ratings_2019.txt\"","text":"%sh\nhdfs dfs -ls pruebas/ratings_2019.txt","user":"anonymous","dateUpdated":"2026-11-16T10:32:28-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792170830930_-345018922","id":"20261016-101350_1191967730","dateCreated":"2026-10-16T10:13:50-0700","dateStarted":"2026-11-16T10:32:28-0800","dateFinished":"2026-11-16T10:32:30-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2278"},{"title":"View the contents of the file \"ratings_2019.txt\" in the \"pruebas\" directory.","text":"%sh\nhdfs dfs -cat pruebas/ratings_2019.txt","user":"anonymous","dateUpdated":"2026-11-16T10:32:30-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792170945907_-1956624188","id":"20261016-101545_205832528","dateCreated":"2026-10-16T10:15:45-0700","dateStarted":"2026-11-16T10:32:30-0800","dateFinished":"2026-11-16T10:32:33-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2279"},{"title":"Download the file \"ratings_2019.txt\" to the \"/user/training/Downloads\" directory on the local operating system.","text":"%sh\nhdfs dfs -get pruebas/ratings_2019.txt /tmp/\nls /tmp/ratings_2019.txt # Verify that the file has been created in the '/tmp' directory of the local operating system","user":"anonymous","dateUpdated":"2026-11-16T10:32:33-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792171005952_-692674874","id":"20261016-101645_1170536466","dateCreated":"2026-10-16T10:16:45-0700","dateStarted":"2026-11-16T10:32:33-0800","dateFinished":"2026-11-16T10:32:37-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2280"},{"title":"Once verified, we can delete the \"ratings_2019.txt\" file from the local operating system.","text":"%sh\nrm /tmp/ratings_2019.txt","user":"anonymous","dateUpdated":"2026-11-16T10:32:37-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792171287248_1394065181","id":"20261016-102127_452248898","dateCreated":"2026-10-16T10:21:27-0700","dateStarted":"2026-11-16T10:32:37-0800","dateFinished":"2026-11-16T10:32:37-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2281"},{"title":"Delete the file \"ratings_2019.txt\" from the \"pruebas\" directory in HDFS","text":"%sh\nhdfs dfs -rm pruebas/ratings_2019.txt","user":"anonymous","dateUpdated":"2026-11-16T10:32:37-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792171381756_-1312873833","id":"20261016-102301_1561063583","dateCreated":"2026-10-16T10:23:01-0700","dateStarted":"2026-11-16T10:32:37-0800","dateFinished":"2026-11-16T10:32:40-0800","status":"FINISHED","errorMessage":"","progressUpdateIntervalMs":500,"$$hashKey":"object:2282"},{"title":"Verify that the file is in the current user's (\"zeppelin\") Trash in HDFS","text":"%sh\nhdfs dfs -ls .Trash/Current/user/zeppelin/pruebas","user":"anonymous","dateUpdated":"2026-11-16T10:32:40-0800","config":{"colWidth":12,"fontSize":9,"enabled":true,"results":{},"editorSetting":{"language":"sh","editOnDblClick":false,"completionKey":"TAB","completionSupport":false},"editorMode":"ace/mode/sh","title":true},"settings":{"params":{},"forms":{}},"apps":[],"jobName":"paragraph_1792171338885_-757954270","id":"20261016-102218_689247588","dateCreated":"2026-10-16T10:22:18-0700","dateStarted":"2026-11-16T10:32:40-0800","dateFinished":"2026-11-16T10:32:43-0800","status":"FINISHED","errorMe